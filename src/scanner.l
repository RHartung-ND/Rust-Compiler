%%
\/\/(.*)                              ;
[/][*][^*]*[*]+([^*/][^*]*[*]+)*[/]   ;
[/][*]                                "TOKEN_UNMATCHED_COMMENT"

array                               "TOKEN_ARRAY"
auto                                "TOKEN_AUTO"
boolean                             "TOKEN_BOOLEAN"
carray                              "TOKEN_CARRAY"
char                                "TOKEN_CHAR"
double                              "TOKEN_DOUBLE"
else                                "TOKEN_ELSE"
false                               "TOKEN_FALSE"
float                               "TOKEN_FLOAT"
for                                 "TOKEN_FOR"
function                            "TOKEN_FUNCTION"
if                                  "TOKEN_IF"
integer                             "TOKEN_INTEGER"
print                               "TOKEN_PRINT"
return                              "TOKEN_RETURN"
string                              "TOKEN_STRING"
true                                "TOKEN_TRUE"
void                                "TOKEN_VOID"
while                               "TOKEN_WHILE"

\(                                   "TOKEN_LPAREN"
\)                                   "TOKEN_RPAREN"
\[                                   "TOKEN_LBRACKET"
\]                                   "TOKEN_RBRACKET"
\+\+                                  "TOKEN_INCREMENT"
--                                  "TOKEN_DECREMENT"
#                                   "TOKEN_UNARY"
\+                                   "TOKEN_PLUS"
-                                   "TOKEN_MINUS"
/                                   "TOKEN_DIVIDE"
\*                                   "TOKEN_TIMES"
%                                   "TOKEN_MOD"
;                                   "TOKEN_SEMICOLON"
\:                                   "TOKEN_COLON"
,                                   "TOKEN_COMMA"
!                                   "TOKEN_NOT"
\{                                   "TOKEN_LBRACE"
\}                                   "TOKEN_RBRACE"
^                                   "TOKEN_CARET"
\<                                   "TOKEN_LESSTHAN"
\>                                   "TOKEN_GREATERTHAN"
=                                   "TOKEN_EQUALS"
\<=                                  "TOKEN_LEQ"
\>=                                  "TOKEN_GEQ"
!=                                  "TOKEN_NEQ"
==                                  "TOKEN_EQUIVALENT"
||                                  "TOKEN_OR"
&&                                  "TOKEN_AND"

[_a-zA-Z][_a-zA-Z0-9]*                "TOKEN_IDENTIFIER"
([0-9]+)|(0x[0-9a-fA-F]+)|(0b[01]+)   "TOKEN_INTEGER_LITERAL"
[0-9]*\.[0-9]+                        "TOKEN_DOUBLE_LITERAL"
\"(\\.|[^\\\"\n])*\"                  "TOKEN_STRING_LITERAL"
\'(.|\\.|\\0x([a-fA-F0-9]){2})\'      "TOKEN_CHAR_LITERAL"


[ \n\t\r]+                            ;
.                                     "TOKEN_ERROR"